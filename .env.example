# Local testing only. Copy to .env.local (gitignored). In CI these come from GitHub Actions secrets.
# Use each project's IPv4 **pooler** connection string from the Supabase dashboard:
#   Project → Connect → "Transaction pooler" (host: aws-<n>-<region>.pooler.supabase.com, port 6543).
# The IPv4 pooler is required — GitHub Actions cannot reach Supabase's IPv6-only direct host.
#
# Percent-encode ONLY these four characters if the password contains them:
#   #  ->  %23      /  ->  %2F      ?  ->  %3F      %  ->  %25
# Everything else (& $ @ : + = ! * etc.) is safe as-is. See TROUBLESHOOTING.md.
#
# Run locally:  npm run keepalive:local
# Inspect one:  npm run inspect SUPABASE_DB_URL_TECHSILON_PROD

SUPABASE_DB_URL_TECHSILON_DEV=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_TECHSILON_PROD=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_NATNLAB_DEV=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_NATNLAB_PROD=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_POLYSILON_DEV=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_POLYSILON_PROD=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
