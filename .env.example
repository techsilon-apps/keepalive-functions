# Local testing only (gitignored as .env). In CI these come from GitHub Actions secrets.
# Use each project's IPv4 **pooler** connection string from the Supabase dashboard:
#   Project → Connect → "Transaction pooler" (host: aws-<n>-<region>.pooler.supabase.com, port 6543).
# The IPv4 pooler is required — GitHub Actions cannot reach Supabase's IPv6-only direct host.
#
# Run locally:  node --env-file=.env keepalive.mjs   (or: pnpm keepalive:local)

SUPABASE_DB_URL_TECHSILON_DEV=postgres://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_TECHSILON_PROD=postgres://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_NATNLAB_DEV=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_NATNLAB_PROD=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
